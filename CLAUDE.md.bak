  # ============================================================
  # MOBILE-ONLY PACKAGES (Android, iOS)
  # ============================================================
  webview_flutter: ^4.10.0          # WebView for mobile (Android/iOS)
  workmanager: ^0.5.2               # Background tasks scheduler (mobile)
